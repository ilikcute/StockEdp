# Salin file ini menjadi `.env` untuk konfigurasi lokal.
# Jangan pernah commit file `.env`.
# File ini hanya mendokumentasikan environment variable yang dibutuhkan.
# Jangan memasukkan password, API key, atau secret asli di file ini.

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

APP_NAME="InventorySystem"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=InventorySystem
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# SESSION
# -----------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# CACHE
# -----------------------------------------------------------------------------

CACHE_STORE=database
CACHE_PREFIX=inventory_system

APP_MAINTENANCE_DRIVER=file

# -----------------------------------------------------------------------------
# QUEUE
# -----------------------------------------------------------------------------

QUEUE_CONNECTION=database

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------

FILESYSTEM_DISK=local

# Maksimum ukuran file upload dalam kilobyte.
MAX_UPLOAD_SIZE_KB=5120

# -----------------------------------------------------------------------------
# MAIL
# -----------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="inventory@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# FRONTEND / VITE
# -----------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
VITE_APP_ENV="${APP_ENV}"
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT_MS=10000

# Hanya variable dengan prefix VITE_ yang dapat dibaca frontend.
# Jangan menyimpan secret, password, atau private API key dalam variable VITE_.

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

VITE_ENABLE_DEBUG_MENU=true
VITE_ENABLE_REALTIME_STOCK=false

# Backend feature flags.
ENABLE_NEGATIVE_STOCK=false
ENABLE_STOCK_RESERVATION=false
ENABLE_INVENTORY_VALUATION=false

# -----------------------------------------------------------------------------
# INVENTORY SETTINGS
# -----------------------------------------------------------------------------

# Metode penilaian stok: FIFO atau WEIGHTED_AVERAGE.
INVENTORY_VALUATION_METHOD=WEIGHTED_AVERAGE

# Jumlah angka desimal untuk quantity dan nilai uang.
INVENTORY_QUANTITY_PRECISION=4
INVENTORY_MONEY_PRECISION=2

# -----------------------------------------------------------------------------
# BROADCASTING
# -----------------------------------------------------------------------------

# Versi awal belum menggunakan Laravel Reverb.
BROADCAST_CONNECTION=log

# Isi konfigurasi berikut jika realtime melalui Reverb diaktifkan.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# Daftar origin frontend yang diizinkan, dipisahkan dengan koma.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Domain stateful untuk Laravel Sanctum.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES
# -----------------------------------------------------------------------------

# Jangan memasukkan key asli di `.env.example`.
EXTERNAL_API_KEY=
ANALYTICS_KEY=